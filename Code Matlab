c = Ac*cos(2*pi*____*t);

% Sinyal AM (DSB-FC)
s = (Ac + Am*____).*cos(2*pi*fc*t);

% Menampilkan grafik
figure;

subplot(____,1,1)
plot(t,____,'b')
